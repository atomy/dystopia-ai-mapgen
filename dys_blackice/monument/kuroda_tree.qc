// Kuroda fibre tree (dys_blackice). Generated by build_tree.py; SMDs live in ../build/monument/
$modelname "blackice/kuroda_tree.mdl"
$cdmaterials "models/blackice/"
$staticprop
$mostlyopaque
$surfaceprop "metal"
$contents "solid"
$illumposition 0 0 200
$body tree "../build/monument/kuroda_tree_ref.smd"
$sequence idle "../build/monument/kuroda_tree_idle.smd" fps 1
$collisionmodel "../build/monument/kuroda_tree_phys.smd"
{
	$concave
	$maxconvexpieces 24
	$mass 20000
}
