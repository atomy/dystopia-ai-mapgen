// Kuroda monument (dys_blackice). Generated by build_monument.py; SMDs live in ../build/monument/
$modelname "blackice/kuroda_monument.mdl"
$cdmaterials "models/blackice/"
$staticprop
$surfaceprop "metal"
$contents "solid"
$illumposition 0 0 160
$body monument "../build/monument/kuroda_monument_ref.smd"
$sequence idle "../build/monument/kuroda_monument_idle.smd" fps 1
$collisionmodel "../build/monument/kuroda_monument_phys.smd"
{
	$concave
	$maxconvexpieces 24
	$mass 20000
}
